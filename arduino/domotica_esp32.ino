// ============================================================
// SETUP
// ============================================================
void setup() {
  Serial.begin(115200);
  Serial2.begin(9600, SERIAL_8N1, RX2_PIN, TX2_PIN);
	Serial2.setTimeout(10);

  // Inizializza OLED I2C
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("Avvio SSD1306 Fallito"));
  } else {
		display.setRotation(2); 
    display.clearDisplay(); display.display();
  }

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
  Serial.println("\nESP32 Connesso! IP: " + WiFi.localIP().toString());

  sincronizzaNTP();
  tuyaGetToken();

  server.on("/", []() { server.send(200, "text/html", generaHTML()); });

  // ------------------------------------------------------------
  // API JSON per app esterne (es. l'app desktop Electron).
  // GET, con header CORS, così si possono chiamare da fetch() senza
  // preflight e senza dover passare dalla pagina HTML.
  // ------------------------------------------------------------
  server.on("/api/data", []() {
    StaticJsonDocument<512> doc;
    doc["temperatura"]       = temperaturaStanza;
    doc["umidita"]           = umiditaStanza;
    doc["datiMeteoRicevuti"] = datiMeteoRicevuti;
    doc["ventilatore"]       = ventilatoreAcceso;
    doc["luci"]              = luciAccese;
    doc["lampada"]           = lampadaAccesa;
    doc["lampadaLuminosita"] = lampadaLuminosita;
    doc["lampadaColore"]     = lampadaColore;
    doc["statoLuceAmbiente"] = statoLuceAmbiente;
    doc["automatismiAttivi"] = automatismiAttivi;

    String json;
    serializeJson(doc, json);
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "application/json", json);
  });

  server.on("/api/toggleVentilatore", []() {
    ventilatoreAcceso = !ventilatoreAcceso;
    Serial2.print(ventilatoreAcceso ? '1' : '0');
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "application/json", String("{\"ventilatore\":") + (ventilatoreAcceso ? "true" : "false") + "}");
  });

  server.on("/api/toggleLuci", []() {
    luciAccese = !luciAccese;
    Serial2.print(luciAccese ? '3' : '2');
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "application/json", String("{\"luci\":") + (luciAccese ? "true" : "false") + "}");
  });

  server.on("/api/toggleLampada", []() {
    lampadaToggle();
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "application/json", String("{\"lampada\":") + (lampadaAccesa ? "true" : "false") + "}");
  });

  server.on("/api/toggleAutomatismi", []() {
    if (automatismiAttivi) {
      automatismiAttiviManuale = false;
      automatismiAttivi = false;
      impostaStatoSchermo(false);
    } else {
      automatismiAttiviManuale = true;
      automatismiAttivi = true;
      impostaStatoSchermo(true);
      statoDisplayCorrente = SHOW_CLIMA;
      ultimoCambioDisplay = millis();
    }
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "application/json", String("{\"automatismiAttivi\":") + (automatismiAttivi ? "true" : "false") + "}");
  });

  server.on("/toggleVentilatore", []() {
    ventilatoreAcceso = !ventilatoreAcceso;
    Serial2.print(ventilatoreAcceso ? '1' : '0');
    server.sendHeader("Location", "/"); server.send(303);
  });

  server.on("/toggleLuci", []() {
    luciAccese = !luciAccese;
    Serial2.print(luciAccese ? '3' : '2');
    server.sendHeader("Location", "/"); server.send(303);
  });

  server.on("/toggleLampada", []() {
    lampadaToggle();
    server.sendHeader("Location", "/"); server.send(303);
  });

  server.on("/setLuminosita", []() {
    if (server.hasArg("val")) lampadaSetBrightness(server.arg("val").toInt());
    server.sendHeader("Location", "/"); server.send(303);
  });

  server.on("/setColore", []() {
    if (server.hasArg("hex")) lampadaSetColor(server.arg("hex"));
    server.sendHeader("Location", "/"); server.send(303);
  });

  // Toggle automazioni manuale dall'utente
  server.on("/abilitaAutomatismi", []() {
    automatismiAttiviManuale = true;
    automatismiAttivi = true;
    Serial.println("Automazioni ABILITATE manualmente.");
    
    // Riaccendi display e resetta i contatori del menu
    impostaStatoSchermo(true); 
    statoDisplayCorrente = SHOW_CLIMA;
    ultimoCambioDisplay = millis();
    
    server.sendHeader("Location", "/"); server.send(303);
  });

  server.on("/disabilitaAutomatismi", []() {
    automatismiAttiviManuale = false;
    automatismiAttivi = false;
    Serial.println("Automazioni DISABILITATE manualmente.");
    
    // Spegni il display (come se fosse notte)
    impostaStatoSchermo(false);
    
    server.sendHeader("Location", "/"); server.send(303);
  });

  server.begin();
  Serial.println("Server Web Domotico Attivo!");
}

// ============================================================
// LOOP
// ============================================================
void loop() {
  server.handleClient();

  // Controllo orario: display notturno + automazioni
  controllaOrario();

  // Scorre la macchina a stati del display se lo schermo è acceso
  aggiornaDisplay();

  if (Serial2.available() > 0) {
    String msg = Serial2.readStringUntil('\n');
    msg.trim();

    // Segnale BUIO dal Nano: accende la lampada solo se le automazioni sono attive
    if (msg == "hey ce buio") {
      statoLuceAmbiente = "BUIO";
      Serial.println("Segnale BUIO ricevuto.");
      if (automatismiAttivi) {
        if (!lampadaAccesa) {
          lampadaAccesa = true;
          Serial.println("-> Automazione: Accendo Lampada Tuya.");
          tuyaSendCommand("{\"commands\":[{\"code\":\"switch_led\",\"value\":true}]}");
        }
      } else {
        Serial.println("-> Automazioni disabilitate, segnale BUIO ignorato.");
      }
    }
		  if (msg == "hey ce luce") {
  statoLuceAmbiente = "LUCE";
  Serial.println("Segnale luce ricevuto.");
  if (automatismiAttivi) {
    if (lampadaAccesa) {
      lampadaAccesa = false;
      Serial.println("-> Automazione: Spengo Lampada Tuya.");
      tuyaSendCommand("{\"commands\":[{\"code\":\"switch_led\",\"value\":false}]}");
    }
  } else {
    Serial.println("-> Automazioni disabilitate, segnale LUCE ignorato.");
  }
}
    else if (msg.startsWith("M:")) {
      String dati = msg.substring(2);
      int idx = dati.indexOf(',');
      if (idx != -1) {
        temperaturaStanza = dati.substring(0, idx).toFloat();
        umiditaStanza = dati.substring(idx + 1).toFloat();
        datiMeteoRicevuti = true;
        Serial.print("Clima -> T:"); Serial.print(temperaturaStanza);
        Serial.print(" H:"); Serial.println(umiditaStanza);
      }
    }
  }
}



