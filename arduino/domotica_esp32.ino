void impostaStatoSchermo(bool acceso) {
  if (acceso) {
    display.ssd1306_command(SSD1306_DISPLAYON);
  } else {
    display.clearDisplay();

    display.display();
    display.ssd1306_command(SSD1306_DISPLAYOFF);
  }
}

void aggiornaDisplay() {
  if (!automatismiAttivi) return; // Se le automazioni/display sono spente, esce





  unsigned long currentMillis = millis();
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  switch(statoDisplayCorrente){
    case SHOW_CLIMA :
      // 1. Mostra Temperatura e Umidità (15 secondi)
    if (currentMillis - ultimoCambioDisplay > 15000) {
      statoDisplayCorrente = SHOW_ANIM;
      ultimoCambioDisplay = currentMillis;
    } else {
      display.setTextSize(1);
      display.setCursor(0, 5);
      display.print("Stato Ambiente:");
      
      display.setTextSize(2);
      display.setCursor(0, 25);
      display.print(temperaturaStanza, 1);
      display.print(" C");
      
      display.setCursor(0, 45);
      display.print(umiditaStanza, 0);
      display.print(" %");
    }
    break;
    case SHOW_ANIM :
    // 2. Mostra Animazione (30 secondi)
    if (currentMillis - ultimoCambioDisplay > 30000) {
      statoDisplayCorrente = SHOW_BOTTONI;
      ultimoCambioDisplay = currentMillis;
    } else {
      // Scorrimento frame
      if (currentMillis - ultimoCambioFrame > VELOCITA_FRAME_MS) {
        frameCorrente = (frameCorrente + 1) % NUMERO_FRAME_ANIMAZIONE;
        ultimoCambioFrame = currentMillis;
      }
      // Disegna il frame
      display.drawBitmap(0, 0, epd_bitmap_allArray[frameCorrente], 128, 64, SSD1306_WHITE);
    }
  
    break;
    case SHOW_BOTTONI :
   // 3. Mostra Stato Pulsanti (15 secondi)
    if (currentMillis - ultimoCambioDisplay > 15000) {
      statoDisplayCorrente = SHOW_ANIM1;
      ultimoCambioDisplay = currentMillis;
    } else {
      display.setTextSize(1);
      
      display.setCursor(0, 10);
      display.print("Ventil.: ");
      display.println(ventilatoreAcceso ? "ACCESO" : "SPENTO");
      
      display.setCursor(0, 30);
      display.print("Luci:    ");
      display.println(luciAccese ? "ACCESE" : "SPENTE");
      
      display.setCursor(0, 50);
      display.print("Tuya:    ");
      display.println(lampadaAccesa ? "ACCESA" : "SPENTA");
    }
    break;
    case SHOW_ANIM1 :
     // 2. Mostra Animazione (30 secondi)
    if (currentMillis - ultimoCambioDisplay > 30000) {
      statoDisplayCorrente = SHOW_CLIMA;
      ultimoCambioDisplay = currentMillis;
    } else {
      // Scorrimento frame
      if (currentMillis - ultimoCambioFrame > VELOCITA_FRAME_MS) {
        frameCorrente = (frameCorrente + 1) % NUMERO_FRAME_ANIMAZIONE1;
        ultimoCambioFrame = currentMillis;
      }
      // Disegna il frame
      display.drawBitmap(0, 0, epd_bitmap1_allArray[frameCorrente], 128, 64, SSD1306_WHITE);
    }
    break;




  }

 
  
  display.display();
}

// ============================================================
// CRITTOGRAFIA TUYA
// ============================================================
String hmacSHA256(const String& key, const String& data) {
  byte hmacResult[32];
  mbedtls_md_context_t ctx;
  mbedtls_md_init(&ctx);
  mbedtls_md_setup(&ctx, mbedtls_md_info_from_type(MBEDTLS_MD_SHA256), 1);
  mbedtls_md_hmac_starts(&ctx, (const uint8_t*)key.c_str(), key.length());
  mbedtls_md_hmac_update(&ctx, (const uint8_t*)data.c_str(), data.length());
  mbedtls_md_hmac_finish(&ctx, hmacResult);
  mbedtls_md_free(&ctx);
  String result = "";
  for (int i = 0; i < 32; i++) {
    if (hmacResult[i] < 0x10) result += "0";
    result += String(hmacResult[i], HEX);
  }
  result.toUpperCase();
  return result;
}

void sincronizzaNTP() {
  configTime(3600, 3600, "pool.ntp.org", "time.nist.gov");
  Serial.print("Sincronizzazione NTP");
  time_t now = 0; int t = 0;
  while (now < 1000000000L && t < 20) { delay(500); Serial.print("."); time(&now); t++; }
  Serial.println(now > 1000000000L ? " OK!" : " FALLITA!");
}

String sha256String(const String& input) {
  byte hash[32];
  mbedtls_md_context_t ctx;
  mbedtls_md_init(&ctx);
  mbedtls_md_setup(&ctx, mbedtls_md_info_from_type(MBEDTLS_MD_SHA256), 0);
  mbedtls_md_starts(&ctx);
  mbedtls_md_update(&ctx, (const uint8_t*)input.c_str(), input.length());
  mbedtls_md_finish(&ctx, hash);
  mbedtls_md_free(&ctx);
  String result = "";
  for (int i = 0; i < 32; i++) {
    if (hash[i] < 0x10) result += "0";
    result += String(hash[i], HEX);
  }
  return result;
}

String tuyaBuildSign(const String& token, const String& t, const String& nonce, const String& method, const String& url, const String& body) {
  String bodyHash = sha256String(body);
  String stringToSign = method + "\n" + bodyHash + "\n\n" + url;
  String strToHmac = (token == "") ? String(TUYA_CLIENT_ID) + t + nonce + stringToSign : String(TUYA_CLIENT_ID) + token + t + nonce + stringToSign;
  return hmacSHA256(TUYA_CLIENT_SECRET, strToHmac);
}

String tuyaAccessToken = "";
unsigned long long tokenExpiryMs = 0;

String tuyaGetToken() {
  struct timeval tv; gettimeofday(&tv, NULL);
  unsigned long long nowMs = (unsigned long long)tv.tv_sec * 1000ULL + (unsigned long long)tv.tv_usec / 1000ULL;
  if (tuyaAccessToken != "" && nowMs < tokenExpiryMs) return tuyaAccessToken;
  char tbuf[20]; snprintf(tbuf, sizeof(tbuf), "%llu", nowMs);
  String t = String(tbuf); String method = "GET"; String url = "/v1.0/token?grant_type=1"; String body = "";
  String sign = tuyaBuildSign("", t, "", method, url, body);
  WiFiClientSecure client; client.setInsecure();
  HTTPClient http; http.setTimeout(10000); http.begin(client, String(TUYA_BASE_URL) + url);
  http.addHeader("client_id", TUYA_CLIENT_ID); http.addHeader("sign", sign); http.addHeader("t", t); http.addHeader("sign_method", "HMAC-SHA256");
  int httpCode = http.GET(); String payload = http.getString(); http.end();
  DynamicJsonDocument doc(768);
  DeserializationError jsonError = deserializeJson(doc, payload);
  if (httpCode != 200 || jsonError) {
    Serial.printf("[Tuya] Token fallito: HTTP %d, JSON %s, heap %u\n", httpCode, jsonError.c_str(), ESP.getFreeHeap());
    Serial.println(payload);
    return "";
  }
  if (doc["success"].as<bool>()) {
    tuyaAccessToken = doc["result"]["access_token"].as<String>();
    long expiresIn = doc["result"]["expire_time"].as<long>();
    tokenExpiryMs = nowMs + (unsigned long long)expiresIn * 1000ULL - 60000ULL;
    return tuyaAccessToken;
  }
  Serial.printf("[Tuya] Token rifiutato: code=%s msg=%s\n", doc["code"] | "?", doc["msg"] | "errore sconosciuto");
  return "";
}

bool tuyaSendCommand(const String& jsonBody) {
  for (int attempt = 0; attempt < 2; attempt++) {
    String token = tuyaGetToken();
    if (token == "") return false;
    struct timeval tv; gettimeofday(&tv, NULL);
    unsigned long long nowMs = (unsigned long long)tv.tv_sec * 1000ULL + (unsigned long long)tv.tv_usec / 1000ULL;
    char tbuf[20]; snprintf(tbuf, sizeof(tbuf), "%llu", nowMs);
    String t = String(tbuf); String method = "POST"; String url = "/v1.0/devices/" + String(TUYA_DEVICE_ID) + "/commands";
    String sign = tuyaBuildSign(token, t, "", method, url, jsonBody);
    WiFiClientSecure client; client.setInsecure();
    HTTPClient http; http.setTimeout(10000); http.begin(client, String(TUYA_BASE_URL) + url);
    http.addHeader("client_id", TUYA_CLIENT_ID); http.addHeader("access_token", token); http.addHeader("sign", sign); http.addHeader("t", t); http.addHeader("sign_method", "HMAC-SHA256"); http.addHeader("Content-Type", "application/json");
    int httpCode = http.POST(jsonBody);
    String payload = http.getString();
    http.end();

    DynamicJsonDocument doc(768);
    DeserializationError jsonError = deserializeJson(doc, payload);
    bool success = httpCode == 200 && !jsonError && doc["success"].as<bool>();
    if (success) {
      Serial.printf("[Tuya] Comando riuscito, heap %u\n", ESP.getFreeHeap());
      return true;
    }

    Serial.printf("[Tuya] Comando fallito (tentativo %d): HTTP %d, code=%s, msg=%s, heap %u\n",
      attempt + 1, httpCode, doc["code"] | "?", doc["msg"] | "risposta non valida", ESP.getFreeHeap());
    Serial.println(payload);
    tuyaAccessToken = "";
    tokenExpiryMs = 0;
  }
  return false;
}

// ------------------------------------------------------------
// CONTROLLO LUCE SMART
// ------------------------------------------------------------
bool lampadaToggle() {
  bool nuovoStato = !lampadaAccesa;
  bool success = tuyaSendCommand("{\"commands\":[{\"code\":\"switch_led\",\"value\":" + String(nuovoStato ? "true" : "false") + "}]}");
  if (success) lampadaAccesa = nuovoStato;
  return success;
}

void lampadaSetBrightness(int val) {
  lampadaLuminosita = constrain(val, 10, 1000);
  tuyaSendCommand("{\"commands\":[{\"code\":\"work_mode\",\"value\":\"white\"},{\"code\":\"bright_value_v2\",\"value\":" + String(lampadaLuminosita) + "}]}");
}

void lampadaSetColor(const String& hex) {
  lampadaColore = "#" + hex;
  long n = strtol(hex.c_str(), NULL, 16);
  float r = ((n >> 16) & 0xFF) / 255.0f; float g = ((n >> 8) & 0xFF) / 255.0f; float b = (n & 0xFF) / 255.0f;
  float mx = max(r, max(g, b)); float mn = min(r, min(g, b)); float d = mx - mn;
  float h = 0, s = 0, v = mx;
  if (d > 0) {
    if (mx == r) h = 60.0f * fmod((g - b) / d, 6.0f);
    else if (mx == g) h = 60.0f * ((b - r) / d + 2.0f);
    else h = 60.0f * ((r - g) / d + 4.0f);
    if (h < 0) h += 360.0f;
    s = d / mx;
  }
  String body = "{\"commands\":[{\"code\":\"work_mode\",\"value\":\"colour\"},{\"code\":\"colour_data_v2\",\"value\":{\"h\":" + String((int)h) + ",\"s\":" + String((int)(s * 1000)) + ",\"v\":" + String((int)(v * 1000)) + "}}]}";
  tuyaSendCommand(body);
}

// ------------------------------------------------------------
// CONTROLLO ORARIO: display notturno + automazioni notturne
// ------------------------------------------------------------
void controllaOrario() {
  time_t now; time(&now);
  struct tm* ti = localtime(&now);
  int ora = ti->tm_hour;

  if (ora == ultimaOraInviata) return;
  ultimaOraInviata = ora;

  // Notte: 22:00 -> display OFF (Nano + OLED locale) + automazioni OFF
  if (ora == 22) {
    Serial2.print('9'); // Manda segnale al Nano
    Serial.println("Display OFF + Automazioni OFF (22:00)");
    automatismiAttivi = false;
    impostaStatoSchermo(false); // Spegne l'OLED I2C locale
  }
  // Mattino: 09:00 -> display ON + automazioni ON (se non disabilitate manualmente)
  else if (ora == 9) {
    Serial2.print('A'); // Manda segnale al Nano
    Serial.println("Display ON (09:00)");
    if (automatismiAttiviManuale) {
      automatismiAttivi = true;
      Serial.println("Automazioni ON (09:00)");
      impostaStatoSchermo(true); // Riaccende l'OLED I2C locale
      statoDisplayCorrente = SHOW_CLIMA;
      ultimoCambioDisplay = millis();
    }
  }
}

